PROJECT=slskdn
GITHUB_REPOSITORY=snapetech-org/slskdN
BINARY=slskd
SERVICE=slskd
DEFAULT_PORT=5030
HEALTH_PATH=/
VERSION_ARGS=--version
RELEASE_ASSET_PREFIX=slskdn-main
DEB_ASSET_PATTERN=slskdn_*_amd64.deb
RPM_ASSET_PATTERN=slskdn-*.x86_64.rpm
LINUX_ARCHIVE_ASSET=slskdn-main-linux-glibc-x64.zip
MACOS_ARCHIVE_ASSET=slskdn-main-osx-x64.zip
WINDOWS_ARCHIVE_ASSET=slskdn-main-win-x64.zip
GHCR_IMAGE=ghcr.io/snapetech/slskdn
DOCKERHUB_IMAGE=snapetech/slskdn
AUR_PACKAGES="slskdn slskdn-bin"
COPR_REPO=slskdn/slskdn
PPA=ppa:keefshape/slskdn
SNAP_NAME=slskdn
CHOCO_PACKAGE=slskdn
WINGET_ID=snapetech.slskdn
HOMEBREW_FORMULA=snapetech/slskdn/slskdn
NIX_FLAKE=github:snapetech-org/slskdN
HELM_CHART=packaging/helm/slskdn
UNRAID_TEMPLATE=packaging/unraid/slskdn.xml
UNRAID_PROFILE=ca_profile.xml
PROXMOX_SCRIPT=packaging/proxmox-lxc/setup-inside-ct.sh
SYNOLOGY_SPK_DIR=packaging/synology-spk
FLATPAK_MANIFEST=packaging/flatpak/io.github.slskd.slskdn.yml
