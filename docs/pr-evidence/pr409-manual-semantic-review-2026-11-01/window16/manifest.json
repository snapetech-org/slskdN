    {
      "sourceId": "src_ee7672e2c14b4a26",
      "source": "User Profile",
      "affectedLocales": [
        "hi"
      ],
      "finding": "This is a button that opens a user profile. रूपरेखा means an outline/overview here; प्रोफ़ाइल is the clear UI term for a user profile."
    },
    {
      "sourceId": "src_eeb4dc5dd7254e67",
      "source": "Create, inspect, update, and delete pod channels.",
      "affectedLocales": [
        "vi"
      ],
      "finding": "MediaCore manages named Pod entities and their channels. The Vietnamese target translates Pod as a generic group, so preserve the entity name."
    },
    {
      "sourceId": "src_eebdd24a77d9ad32",
      "source": "Confirm",
      "affectedLocales": [
        "ar"
      ],
      "finding": "The string appears in a confirmation modal heading before an action label. يتأكد is a third-person verb (“he makes sure”); a noun heading is appropriate for “Confirm [action]”."
    },
    {
      "sourceId": "src_eec28f72d1c4d348",
      "source": "Mesh Pods are disabled",
      "affectedLocales": [
        "ar"
      ],
      "finding": "This is the empty-state title for a disabled product feature. الحاضنات الشبكية means network incubators rather than the named Mesh Pods feature; retain the feature name."
    },
    {
      "sourceId": "src_eecce457ca6dc472",
      "source": "Thread Count:",
      "affectedLocales": [
        "hi",
        "pt-BR",
        "ar",
        "vi",
        "id"
      ],
      "finding": "The callsite reports a system resource count. These targets use a textile thread, forum topic, or similarly non-computing meaning; use the computing term for execution threads."
    },
    {
      "sourceId": "src_ef03ba1fe0744885",
      "source": "Buffering: {title}.",
      "affectedLocales": [
        "pt-BR",
        "id"
      ],
      "finding": "This is an active playback status followed by the track title. These targets are nouns meaning a buffer/cushion rather than the buffering action; render the ongoing playback state."
    },
    {
      "sourceId": "src_ef2b9f7166899676",
      "source": "Transfer history retention settings",
      "affectedLocales": [
        "hi",
        "ar"
      ],
      "finding": "The aria-label names settings for retaining the transfer history. The current Hindi is a literal retention calque and the Arabic reverses the phrase into “transfer retention settings”; use an explicit history-retention construction."
    },
    {
      "sourceId": "src_ef611f6e4b446cdd",
      "source": "Total Retrievals:",
      "affectedLocales": [
        "ko"
      ],
      "finding": "These counters are retrievals from a descriptor/retrieval cache, not user search queries. The Korean target says search count; 조회 is the appropriate lookup/retrieval count here."
    },
    {
      "sourceId": "src_ef7040224c4f8af9",
      "source": "Pod Message Routing",
      "affectedLocales": [
        "vi"
      ],
      "finding": "This MediaCore heading names routing for messages sent through Pod entities. The Vietnamese target translates Pod as a generic group; preserve the entity name."
    },
    {
      "sourceId": "src_efb52e7172b77731",
      "source": "Theme",
      "affectedLocales": [
        "hi",
        "ko"
      ],
      "finding": "The paintbrush menu changes the web UI color theme. These targets mean topic/subject rather than a visual theme; use the UI theme term."
    }
