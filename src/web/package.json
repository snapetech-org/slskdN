{
  "browserslist": {
    "development": [
      ">0.3%",
      "not ie 11",
      "not dead",
      "not op_mini all"
    ],
    "production": [
      ">0.3%",
      "not ie 11",
      "not dead",
      "not op_mini all"
    ]
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@microsoft/signalr": "^10.0.11",
    "@uiw/react-codemirror": "^4.25.12",
    "axios": "^1.20.0",
    "butterchurn": "^2.6.7",
    "butterchurn-presets": "^2.4.7",
    "lz-string": "^1.4.4",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-responsive": "^10.0.1",
    "react-router-dom": "^7.18.4",
    "react-toastify": "^11.1.0",
    "react-window": "^2.3.3",
    "semantic-ui-less": "^2.5.0",
    "semantic-ui-react": "npm:react-fomantic-ui@3.0.0-beta.5",
    "uuid": "^14.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@semantic-ui-react/css-patch": "^1.1.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import": "npm:eslint-plugin-import-x@^4.16.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.0",
    "less": "^4.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "name": "@slskdn/web",
  "overrides": {
    "css-select": "^3.1.0",
    "css-what": "^5.0.1",
    "ws": "^8.18.0",
    "lodash-es": "^4.18.1"
  },
  "private": true,
  "scripts": {
    "build": "vite build",
    "check:bundle": "node ./scripts/check-bundle-size.mjs",
    "check:e2e-types": "tsc --noEmit -p tsconfig.e2e.json",
    "bundle:baseline": "node ./scripts/check-bundle-size.mjs --write-baseline",
    "check:anonymous-endpoints": "bash ../../scripts/check-anonymous-endpoints.sh",
    "check:controller-csrf": "bash ../../scripts/check-controller-csrf.sh",
    "check:remediation": "bash ../../scripts/check-remediation-baseline.sh",
    "check:web-fetch-csrf": "bash ../../scripts/check-web-fetch-csrf.sh",
    "check:web-mediacore-routes": "bash ../../scripts/check-web-mediacore-routes.sh",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "postinstall": "semantic-ui-css-patch",
    "pretest:e2e": "pnpm run build && pnpm run check:e2e-types",
    "pretest:e2e:ci": "pnpm run build && pnpm run check:e2e-types",
    "start": "vite",
    "test": "vitest run",
    "test:build-output": "node ./scripts/verify-build-output.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --reporter=line",
    "test:core:soulseek-journeys": "bash ../../scripts/test-core-soulseek-journeys.sh",
    "test:player:audio-output": "bash ../../scripts/test-player-audio-output.sh",
    "test:player:radio-soak": "RUN_PLAYER_RADIO_SOAK=1 pnpm exec playwright test e2e/player-radio-network.spec.ts --grep @player-radio-soak --workers=1 --retries=0 --trace=off --reporter=line",
    "test:player:resource-control": "RUN_PLAYER_RESOURCE_CONTROL=1 SLSKDN_PLAYER_RESOURCE_CONTROL_WINDOW_SECONDS=60 SLSKDN_PLAYER_RESOURCE_CONTROL_WINDOWS=40 playwright test e2e/player-resource-control.spec.ts --workers=1 --retries=0 --trace=off --reporter=line",
    "test:player:resource-app-control": "SLSKDN_PLAYER_RESOURCE_PROFILE=hidden-app SLSKDN_PLAYER_RESOURCE_WINDOW_SECONDS=60 SLSKDN_PLAYER_RESOURCE_WINDOWS=60 playwright test e2e/player-resources.spec.ts --grep 'records player and application browser resource use' --workers=1 --retries=0 --trace=off --reporter=line",
    "test:player:radio-high-rate": "pnpm run build && playwright test e2e/player-radio-network.spec.ts --grep @player-radio-high-rate --workers=1 --retries=0 --trace=off --reporter=line",
    "test:player:screen-reader": "bash ../../scripts/test-player-screen-reader.sh",
    "test:player:soulseek-radio": "bash ../../scripts/test-player-soulseek-radio.sh",
    "test:player:resources": "playwright test e2e/player-resources.spec.ts --workers=1 --trace=off --reporter=line",
    "test:player:resource-cycles": "SLSKDN_PLAYER_RESOURCE_CYCLES=1 playwright test e2e/player-resources.spec.ts --grep @player-resource-cycles --workers=1 --retries=0 --trace=off --reporter=line",
    "test:native-milkdrop-compatibility": "node ./scripts/report-native-milkdrop-compatibility.mjs",
    "test:native-milkdrop-performance": "node ./scripts/measure-native-milkdrop-performance.mjs",
    "test:native-milkdrop-smoke": "node ./scripts/smoke-native-milkdrop.mjs",
    "test-unattended": "vitest run"
  },
  "version": "0.1.0"
}
